# Required: paste the Postman workspace URL where Agent Mode is available.
POSTMAN_WORKSPACE_URL=https://your-team.postman.co/workspace/xxxxxxxx?sideView=agentMode

# Local OpenAI-compatible server.
# Single shared key, OR a JSON map of userId -> key for multi-user/tunnel setups.
# Each user gets their own isolated Postman tab (see POSTMAN_MAX_TABS).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# BRIDGE_API_KEY=sk-postman-local
# BRIDGE_API_KEYS={"default":"sk-postman-local","alice":"sk-alice","bob":"sk-bob"}
BRIDGE_API_KEYS={"default":"sk-postman-local"}

# Browser. On Windows with normal Chrome, "chrome" is usually best.
BROWSER_CHANNEL=chrome
# Optional CDP attach mode: attach to a dedicated Chrome window with a debug
# profile. Chrome 136+ ignores --remote-debugging-port on the default profile,
# so a separate --user-data-dir is REQUIRED (it runs alongside your normal Chrome):
#   chrome.exe --remote-debugging-port=9222 --user-data-dir=.\ .chrome-cdp-profile
# The bridge auto-relaunches this window if it is closed.
# BROWSER_CDP_URL=http://127.0.0.1:9222
# POSTMAN_CDP_PROFILE_DIR=.chrome-cdp-profile
# Optional explicit executable path, useful for Chromium or portable Chrome.
# An cua so Chrome debug de tool chay ngam toan bo
# BROWSER_CDP_HIDDEN=true

# BROWSER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
POSTMAN_PROFILE_DIR=.postman-profile
POSTMAN_HEADLESS=false

# Timing.
POSTMAN_NAVIGATION_TIMEOUT_MS=45000
POSTMAN_COMPLETION_TIMEOUT_MS=180000
POSTMAN_RESPONSE_STABLE_MS=2200
POSTMAN_MODEL_CACHE_TTL_MS=300000

# Multi-user: max concurrent agent tabs (one tab per user, isolated context).
POSTMAN_MAX_TABS=5
# Close a user's tab after this idle time to free slots.
POSTMAN_TAB_IDLE_TTL_MS=600000

# Optional selector overrides if Postman changes its UI.
# POSTMAN_SELECTOR_COMPOSER=textarea[placeholder*="Describe what you need"]
# POSTMAN_SELECTOR_MODEL_BUTTON=
# POSTMAN_SELECTOR_ASSISTANT_MESSAGE=
# POSTMAN_SELECTOR_NEW_CHAT=
# POSTMAN_SELECTOR_GENERATING=
